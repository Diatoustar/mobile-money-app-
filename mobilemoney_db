CREATE TABLE CLIENT (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nom VARCHAR(50) NOT NULL,
    prenom VARCHAR(50) NOT NULL,
    telephone VARCHAR(100) UNIQUE NOT NULL,
    adresse VARCHAR(100)
);


CREATE TABLE COMPTE (
    id INT AUTO_INCREMENT PRIMARY KEY,
    numero_compte VARCHAR(100) UNIQUE NOT NULL,
    solde DOUBLE DEFAULT 0.0,
    client_id INT NOT NULL,
    CONSTRAINT fk_client FOREIGN KEY (client_id) REFERENCES CLIENT(id) ON DELETE CASCADE
);

CREATE TABLE OPERATIONS (
    id INT AUTO_INCREMENT PRIMARY KEY,
    type_operation ENUM('DEPOT', 'RETRAIT', 'TRANSFERT', 'PAIEMENT') NOT NULL,
    montant DOUBLE NOT NULL,
    date_operation DATETIME DEFAULT CURRENT_TIMESTAMP,
    compte_source INT,
    compte_destination INT,
    marchand VARCHAR(50),
    CONSTRAINT fk_compte_source FOREIGN KEY (compte_source) REFERENCES COMPTE(id),
    CONSTRAINT fk_compte_dest FOREIGN KEY (compte_destination) REFERENCES COMPTE(id)
)

